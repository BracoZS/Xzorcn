@* Este archivo define la estructura de rutas y el layout comun. *@
@import Layout from "./layouts/Layout.xzor"

@* Every page renders inside Layout; unknown addresses get a generic message. *@
@ClientRoutes(route) {
  @notFound { <Layout><p>Not found: @route.path</p></Layout> }
  @default(page) { <Layout>@page</Layout> }
}
