@page "/"

<section class="min-h-screen bg-slate-50 px-6 py-10 text-slate-950">
  <div class="mx-auto max-w-5xl">
    <header class="flex items-center justify-between border-b border-slate-200 pb-5">
      <a href="/" class="flex items-center gap-3 font-semibold tracking-tight">
        <span class="grid size-9 place-items-center rounded-lg bg-slate-950 text-sm text-white">X</span>
        <span>xzor/ui</span>
      </a>
      <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600">
        En desarrollo
      </span>
    </header>

    <main class="grid items-center gap-12 py-20 md:grid-cols-2 md:py-28">
      <div>
        <p class="mb-4 text-sm font-medium text-slate-500">Una base para construir tu sistema de diseño</p>
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
          Componentes para Xzor. A tu manera.
        </h1>
        <p class="mt-5 max-w-lg text-lg leading-8 text-slate-600">
          Una colección de componentes simples, accesibles y personalizables para empezar tu proyecto.
        </p>
        <a
          href="#preview"
          class="mt-8 inline-flex rounded-md bg-slate-950 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-slate-800"
        >
          Ver vista previa
        </a>
      </div>

      <section id="preview" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-start justify-between">
          <div>
            <h2 class="font-semibold tracking-tight">Panel de ejemplo</h2>
            <p class="mt-1 text-sm text-slate-500">Una tarjeta básica hecha con Tailwind.</p>
          </div>
          <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">
            Listo
          </span>
        </div>
        <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm font-medium">Tu proyecto empieza aquí</p>
          <p class="mt-1 text-sm text-slate-500">Agrega componentes y dales tu propio estilo.</p>
        </div>
        <button
          type="button"
          class="mt-5 rounded-md bg-slate-950 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-slate-800"
        >
          Botón de ejemplo
        </button>
      </section>
    </main>
  </div>
</section>
