@page "/"
@import { siteConfig as configuredSite } from "../config/site"

@code {
  site = configuredSite;
}

<div class="flex flex-1 flex-col">
  <main class="flex flex-1 flex-col" aria-label="Contenido principal">
    <section class="border-b border-slate-200">
      <div class="mx-auto flex max-w-screen-2xl flex-col items-center gap-3 px-6 py-16 text-center md:py-20 lg:py-24">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
          Built for Xzor
          <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>

        <h1 class="max-w-4xl text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">
          A foundation for your next interface
        </h1>

        <p class="max-w-2xl text-base leading-7 text-slate-600 text-balance sm:text-lg">
          Thoughtful, accessible building blocks to create custom interfaces with Xzor.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
          <a
            href="@site.repositoryUrl"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-9 items-center justify-center rounded-full bg-slate-950 px-4 text-sm font-medium text-white transition-colors hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2"
          >
            View the source
          </a>
          <a
            href="@site.frameworkUrl"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-9 items-center justify-center rounded-full bg-slate-100 px-4 text-sm font-medium text-slate-900 transition-colors hover:bg-slate-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2"
          >
            About Xzor
          </a>
        </div>
      </div>
    </section>

    <div class="min-h-32 flex-1" aria-hidden="true"></div>
  </main>

  <footer class="border-t border-slate-200 px-6 py-6 text-center text-sm text-slate-500">
    Built by
    <a
      href="@site.authorUrl"
      target="_blank"
      rel="noopener noreferrer"
      class="font-medium text-slate-700 underline-offset-4 hover:text-slate-950 hover:underline"
    >@site.authorName</a>.
    The source code is available on
    <a
      href="@site.repositoryUrl"
      target="_blank"
      rel="noopener noreferrer"
      class="font-medium text-slate-700 underline-offset-4 hover:text-slate-950 hover:underline"
    >GitHub</a>.
  </footer>
</div>
